enable
configure terminal
hostname Servicios
no ip domain-lookup
spanning-tree mode rapid-pvst 
enable secret jimenez
line console 0
password Ezequiel
login
exit
line vty 0 4
password Ezequiel
login
exit
banner motd #Advertencia, Solo Personal Autorizado#
service password-encryption

vlan 30
name Servidores
exit
interface vlan 30
no shutdown
exit
vlan 20
name Usuarios-administradores
exit
interface vlan 20
no shutdown
exit
vlan 10
name Servidores
exit
interface vlan 10
no shutdown
exit
interface gig0/0
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk nonegotiate
switchport trunk allow vlan 1,10,20,30
no shutdown
exit


interface gig0/1
switchport mode access
switchport access vlan 10
switchport port-security
switchport port-security maximum 2
switchport port-security violation shutdown
spanning-tree portfast
spanning-tree bpduguard enable 
no shutdown
exit

interface gig0/2
switchport mode access
switchport access vlan 20
switchport port-security
switchport port-security maximum 2
switchport port-security violation shutdown
spanning-tree portfast
spanning-tree bpduguard enable 
no shutdown
exit

interface range gig1/0-2
switchport mode access
switchport access vlan 30
switchport port-security
switchport port-security maximum 2
switchport port-security violation shutdown
spanning-tree portfast
spanning-tree bpduguard enable 
no shutdown
exit



exit
write
copy running-config startup-config

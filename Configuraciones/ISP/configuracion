enable
configure terminal
hostname ISP
ip name-server 8.8.8.8
no ip domain-lookup
interface e1/1
ip address dhcp
ip nat outside
no shutdown
exit
interface e1/0
ip address 200.8.63.1 255.255.255.252
ip nat inside
no shutdown
exit

interface e1/2
ip address 200.8.63.5 255.255.255.252
ip nat inside
no shutdown
exit

